# Copy this file to .env and fill in values locally.
# Never commit a real API key.

# ── AI mode ───────────────────────────────────────────────────────────────────
# mock = simulated AI responses (no API key, no network required)
# live = real API (requires AI_API_KEY + provider settings below)
AI_MODE=mock

# ── Provider ──────────────────────────────────────────────────────────────────
# openai_compatible = any OpenAI-compatible Chat Completions endpoint
#   (NVIDIA NIM, Groq, Together, Ollama, OpenRouter, ...)
# openai_native     = api.openai.com via the OpenAI Responses API
AI_PROVIDER=openai_compatible

# ── API key ───────────────────────────────────────────────────────────────────
# Paste the API key for your chosen provider.
# The key is stored only in this file and never written to the database or logs.
AI_API_KEY=

# ── Base URL (openai_compatible only) ─────────────────────────────────────────
# Enter the full base URL for your OpenAI-compatible endpoint, e.g.:
#   NVIDIA NIM:   https://integrate.api.nvidia.com/v1
#   Groq:         https://api.groq.com/openai/v1
#   Ollama:       http://localhost:11434/v1
#   OpenRouter:   https://openrouter.ai/api/v1
AI_BASE_URL=

# ── Model ─────────────────────────────────────────────────────────────────────
# Enter the exact model identifier from your provider, e.g.:
#   NVIDIA NIM:   meta/llama-3.2-11b-vision-instruct
#   Groq:         llama-3.3-70b-versatile
#   OpenAI:       gpt-4o-mini
AI_MODEL=

# ── Legacy variable names (still accepted for existing .env files) ─────────────
# These are equivalent to the canonical names above; the app reads both.
# New installs should use the canonical names instead.
#
# CUSTOM_API_KEY  = same as AI_API_KEY
# CUSTOM_BASE_URL = same as AI_BASE_URL
# CUSTOM_MODEL    = same as AI_MODEL
# OPENAI_API_KEY  = same as AI_API_KEY when AI_PROVIDER=openai_native
